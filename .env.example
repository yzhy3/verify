# Discord
CLIENT_ID=
CLIENT_SECRET=
DISCORD_TOKEN=

# Public URL of THIS Vercel deployment (no trailing slash)
PUBLIC_URL=https://tu-proyecto.vercel.app

# Secret for signing state (long random string)
SESSION_SECRET=

# Guild / Role
GUILD_ID=
VERIFIED_ROLE_ID=
LOG_CHANNEL_ID=
SERVER_INVITE=https://discord.gg/xxxxx
SERVER_NAME=Mi Server

# Minimum account age in days
MIN_ACCOUNT_AGE_DAYS=7

# Upstash Redis (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
